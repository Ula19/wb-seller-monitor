# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Кто входит на сайт и получает уведомления: Telegram ID через запятую (узнать — /start у бота).
# Одно общее пространство: данные принадлежат ПЕРВОМУ ID, ему же бэкап и системные алерты.
SUPERADMIN_IDS=123456789

# Прокси к WB через запятую (socks5h://host:port или http://user:pass@host:port).
# Нужен обязательно: прямой IP сервера антибот WB палит. Первый прокси — для веб-сессии.
WB_PROXIES=

# Открытый ключ age для шифрования ежедневного бэкапа БД (age1…). Сгенерировать у себя:
# age-keygen -o key.txt — закрытый ключ из key.txt в менеджер паролей, на сервер НЕ класть.
BACKUP_AGE_RECIPIENT=

# Ключ шифрования сессий аккаунтов WB в БД. Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACCOUNTS_KEY=

# Сайт: домен (A-запись → IP сервера; Caddy сам выпустит HTTPS; в @BotFather /setdomain → этот домен
# для входа через Telegram), секрет подписи cookie сессии (сгенерировать: python -c "import secrets;
# print(secrets.token_urlsafe(48))") и запасной пароль владельца — вход по нему включён только при ≥20 символах.
SITE_DOMAIN=
SESSION_SECRET=
SITE_PASSWORD=

# Остальное (БД, интервалы, пороги, троттлинг) — с рабочими дефолтами в app/config.py.
# guardium/Bearer задаются кнопкой «🔑 Токены», вход в WB — командой /wblogin.
