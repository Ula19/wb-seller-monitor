# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram ID владельца (админа). Узнать свой ID можно у @userinfobot
OWNER_ID=123456789

# Подключение к Postgres (внутри docker-compose хост = db)
DATABASE_URL=postgresql+asyncpg://wb:wb@db:5432/wb

# Интервал единого прохода мониторинга, секунд: ВСЕ магазины каждые N секунд.
# b2b-магазины дополнительно дёргают detail с кукой каждый проход.
# Быстрее 60 нет смысла: каталог WB — CDN, его кэш всё равно отстаёт на минуты.
MONITOR_INTERVAL_SECONDS=60
# Сколько товаров в магазине, чтобы слать отчёт Excel-файлом вместо текста
BIG_SHOP_THRESHOLD=100

# Минимальное СНИЖЕНИЕ цены в % для уведомления. Рост цены не алертим вовсе.
# Мягкий порог отсекает мизерные копеечные сдвиги.
PRICE_DROP_THRESHOLD_PCT=1

# Наша цена = цена ВБ минус этот процент
OUR_DISCOUNT_PCT=15

# Скидка WB Кошелька: у розничных магазинов рядом с ценой показываем «с кошельком −N%».
# Только отображение — в БД хранится цена без кошелька (каталожная витрина покупателя).
# 0 = не показывать вторую цену.
WB_WALLET_DISCOUNT_PCT=6

# Троттлинг запросов к WB. WB банит за ТЕМП: безопасно ≤~100 req/час, паузы 3-7с.
# Меньше этих значений = риск 403 и бана IP. Без прокси не уменьшай.
REQUEST_MIN_DELAY=3.0
REQUEST_JITTER=4.0

# 1 = магазины по /addseller по умолчанию в режиме бизнес-цен (нужен WB_BEARER).
WB_B2B=1

# Токены из приложения WB (снимаются перехватом трафика телефона), актуальные
# обновляются кнопкой «Токены» и хранятся в БД; здесь — стартовые значения.
# guardium (заголовок x-guardium-token) — каталог и бизнес-цены, живёт ~3 дня.
WB_GUARDIUM=
# Bearer (заголовок authorization, "Bearer eyJ...") — бизнес-цены, срока нет.
WB_BEARER=
# deviceid/UA — с того же телефона, где сняты токены. udg — из запроса бизнес-режима.
# WB_IOS_DEVICE_ID=
# WB_IOS_UA=
# WB_B2B_UDG=82

# Прокси к WB: пул равнозначных слотов = прямой IP сервера + по слоту на каждый
# прокси. Магазины делятся по слотам и опрашиваются параллельно; слот магазина
# обслуживает и каталог, и b2b-detail. Класс/гео IP не важны нигде (проверено:
# каталог и __internal отвечают 200 с датацентрового/резидентных/direct при живой
# куке) — бери любые дешёвые, важен только суммарный темп (больше слотов = меньше
# запросов на IP = меньше 429). Список через запятую. Пусто = только прямой IP.
#   WB_PROXIES=socks5h://1.2.3.4:1080
#   WB_PROXIES=http://user:pass@gate.provider.com:8000
WB_PROXIES=

# Дебаг: 1 = логировать сырой JSON первого товара (смотрим все поля API). Потом выключить.
DEBUG_RAW=0
